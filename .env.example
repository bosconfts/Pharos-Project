# Blockfrost (https://blockfrost.io)
BLOCKFROST_PROJECT_ID=mainnetXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
BLOCKFROST_BASE_URL=https://cardano-mainnet.blockfrost.io/api/v0

# Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# PostgreSQL + pgvector
DATABASE_URL=postgresql://pil:pil_secret@localhost:5432/pil

# Cardano wallet (mainnet) — usado APENAS por core/publisher.py.
# Nunca configure estas variáveis no serviço web.
PIL_WALLET_ADDRESS=addr1v...
PIL_SIGNING_KEY_PATH=wallet/payment.skey

# Interruptor mestre da publicação on-chain. Com "false", nenhuma transação
# é submetida por nenhum caminho de código. Ligue apenas no publisher.
PIL_ENABLE_ONCHAIN=false

# Neo4j (M3 — Conflict Detection)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here
